</style><style type="text/css">
              html body p,span {
                  -webkit-user-select: text !important;
                  -khtml-user-select: text !important;
                  -moz-user-select: text !important;
                  -ms-user-select: text !important;
                  user-select: text !important;
              }


              lighter {
                  font-family: inherit !important;
                  font-size: inherit !important;
                  font-weight: inherit !important;
                  cursor: pointer !important;
              }

              lighter {
                background-image: initial !important;
              }


              l-core.L-underline {
                border-bottom: 2px solid rgba(64, 158, 255, 1) !important;
                animation: L-coreBorderAnimation 1s;
                background: rgba(64, 158, 255, 0.2) !important;
                cursor: pointer !important;
              }

              l-core.L-auto-highlight {
                cursor: pointer;
                text-decoration: underline;
                text-decoration-style: dotted;
                text-decoration-color: #EAFFB6;
                background: #EAFFB6;
              }
              
          
              
              l-core.L-auto-highlight.active {
                cursor: pointer;
                text-decoration: underline;
                text-decoration-style: dotted;
                text-decoration-color: #ddf997;
                background: #ddf997; 
              }

              l-core.L-auto-highlight.L-hidden {
                cursor: auto;
                text-decoration: auto;
                text-decoration-style: revert;
                text-decoration-color: inherit;
                background: inherit;
              } 


              l-core.L-summary-content {
                background: #FFCA90 !important;
                cursor: pointer !important;
              }

              l-core.L-underline.L-bgHover {
                background: #ECEFED !important;
                transition: background 0.2s !important;
              }

              @keyframes L-coreBorderAnimation {
                0% {
                  border-bottom-color: rgba(64, 158, 255, 0.5)
                }
                100% {
                  border-bottom-color: rgba(64, 158, 255, 1)
                }
              }

              .ab-iam-root {
                  z-index: 99999999999999999999 !important;
              }

              .OrderDetails-items {
                  display: none;
              }

              .OrderDetails-footer .OrderDetailsFooter-subtotal {
                  display: none;
              }

              .OrderDetails-footer .OrderDetailsFooter-subtotalItems {
                  display: none;
              }

              .OrderDetails-footer .OrderDetails-total {
                  display: none;
              }

              .PSPDFKit-Popover-Text-Markup-Toolbar {
                  display: none;
              }

              .liner-mini-button {
                  display: none;
                  position: absolute !important;
                  width: auto;
                  height: 30px !important;
                  z-index: 999999999999 !important;
              }

              .liner-mini-button .liner-mb {
                  display: flex;
                  cursor: pointer !important;
                  max-width: initial !important;
                  width: 30px !important;
                  height: 30px !important;
                  position: absolute !important;
                  left: 0 !important;
                  top: 0 !important;
                  opacity: 1 !important;
                  border: none !important;
                  -webkit-box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2) !important;
                  -moz-box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2) !important;
                  box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2) !important;
                  background-color: #ffffff !important;
                  border-radius: 40px !important;
                  background-size: 20px !important;
                  background-position: center !important;
                  background-repeat: no-repeat !important;
                  background-image: url("data:image/svg+xml;base64,") !important;

              }

              .liner-mini-button .liner-mb:not(.liner-mb-disabled)::after {
                position: absolute !important;
                bottom: 5px !important;
                left: 5px !important;
                content: '' !important;
                background: #ffff83;
                width: 20px !important; 
                height: 3px !important;
                border-radius: 2px !important;
              }

              .liner-mini-button .liner-mb.liner-mb-disabled {
                background-size: 30px !important;
                background-image: url("data:image/svg+xml;base64,") !important;
              }

              .liner-page-tooltip-body-point {
                  position: absolute !important;
                  left: 2px !important;
                  top: 9px !important;
                  width: 8px !important;
                  height: 8px !important;
                  z-index: 2 !important;
                  background-color: #52565d !important;
                  border-top: 1px solid #969aa2 !important;
                  border-left: 1px solid #969aa2 !important;
                  border-top-left-radius: 4px !important;
                  transform: rotate(317deg) skew(16deg, 12deg) !important;
              }

              .liner-page-text-only-tooltip {
                  position: relative !important;
              }

              .liner-page-tooltip-body {
                  display: table !important;
                  margin-left: 6px !important;
                  padding: 5px 11px !important;
                  background-color: #52565d !important;
                  border: 1px solid #969aa2 !important;
                  border-radius: 8px !important;
                  box-shadow: 0 4px 8px 0 rgba(39, 43, 49, 0.3) !important;
                  font-family: system-ui !important;
                  font-stretch: normal !important;
                  font-style: normal !important;
                  font-weight: 400 !important;
                  line-height: 1.3em !important;
                  letter-spacing: -.35px !important;
                  font-size: 12px !important;
                  color: #fff !important;
                  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5) !important;
              }

              .liner-page-tooltip-body span {
                  display: inline-block !important;
              }

              .liner-mini-tooltip {
                  display: none;
                  position: absolute !important;
                  z-index: 1003 !important;
              }

              .liner-mini-tooltip.liner-enabled {
                  width: 186px !important;
                  height: 30px !important;
                  padding: 6px 2px 6px 35px !important;
                  box-sizing: border-box !important;
                  border-radius: 30px !important;
                  box-shadow: 0 1px 4px 0 rgba(0, 0, 0, 0.2) !important;
                  background-color: #fff !important;
              }

              .liner-mini-color-circle {
                  display: flex !important;
                  align-items: center !important;
                  justify-content: center !important;
                  position: relative !important;
                  width: 18px !important;
                  height: 18px !important;
                  margin: 0 3px !important;
                  float: left !important;
                  border-radius: 50% !important;
                  cursor: pointer !important;
              }

              .liner-mini-color-circle.liner-color-lock {
                user-select: none !important;
              }

              .liner-color-label, .liner-youtube-color-label {
                  display: none;
                  position: absolute;
                  max-width: 80px;
                  text-overflow: ellipsis;
                  overflow: hidden;
                  white-space: nowrap;
                  height: 17px;
                  top: -24px;
                  padding: 2px 3px 0px 3px;
                  color: white;
                  background-color: #52565D;
                  border-radius: 2px;
                  font-family: system-ui !important;
                  font-weight: 400;
                  font-size: 11px;
                  line-height: 13px;
              }

              .liner-mini-color-circle:hover .liner-color-label {
                display: block;
              }

              .liner-color-label.LinerHover, .liner-youtube-color-label.LinerHover {
                display: block;
              }

              .liner-tooltip-icon:hover, .liner-youtube-tooltip-icon:hover {
                  background-color: #f2f3f7 !important;
                  border-radius: 30px !important;
                  transition: background-color 0.3s !important;
              }

              .liner-tooltip-color-picker-icon-part, .liner-youtube-tooltip-color-picker-icon-part {
                  position: absolute !important;
                  display: inline-block !important;
                  width: 18px !important;
                  height: 18px !important;
                  border-radius: 100px !important;
              }

              .liner-tooltip-menu .liner-tooltip-color, .liner-youtube-tooltip-menu .liner-youtube-tooltip-color {
                  position: absolute !important;
                  top: 3px !important;
                  left: 10px !important;
                  display: inline-block !important;
                  width: 28px !important;
                  height: 28px !important;
              }

              .liner-youtube-tooltip-menu .liner-youtube-tooltip-color {
                cursor: pointer !important;
              }

              .liner-tooltip-menu.liner-desktop .liner-tooltip-color, .liner-youtube-tooltip-menu .liner-youtube-tooltip-color {
                position: unset !important;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
              }

              .liner-tooltip-menu .liner-tooltip-comment, .liner-youtube-tooltip-menu .liner-youtube-tooltip-comment {
                  display: inline-block !important;
                  position: absolute !important;
                  top: 3px !important;
                  left: 46px !important;
                  width: 28px !important;
                  height: 28px !important;
                  cursor: pointer !important;
                  background-image: url(data:image/svg+xml;base64,) !important;
                  background-size: 24px 24px !important;
                  background-position: center !important;
                  background-repeat: no-repeat !important;
              }

              .liner-tooltip-menu.liner-desktop .liner-tooltip-comment, .liner-youtube-tooltip-menu .liner-youtube-tooltip-comment {
                position: unset !important;
              }

              .liner-tooltip-menu .liner-tooltip-undo, .liner-youtube-tooltip-menu .liner-youtube-tooltip-undo {
                  display: inline-block !important;
                  position: absolute !important;
                  top: 3px !important;
                  right: 9px !important;
                  width: 28px !important;
                  height: 28px !important;
                  background-image: url(data:image/svg+xml;base64,) !important;
                  background-size: 24px 24px !important;
                  background-position: center !important;
                  background-repeat: no-repeat !important;
              }

              .liner-tooltip-menu.liner-desktop .liner-tooltip-comment, .liner-youtube-tooltip-menu .liner-youtube-tooltip-comment {
                position: unset !important;
              }

              .liner-tooltip-menu.liner-desktop .liner-tooltip-undo, .liner-youtube-tooltip-menu .liner-youtube-tooltip-undo {
                position: unset !important;
              }

              .liner-tooltip-wrap .liner-color-picker, .liner-youtube-tooltip-wrap .liner-youtube-color-picker {
                  display: none;
                  width: 207px !important;
                  height: 30px !important;
                  margin-left: -43px !important;
                  box-sizing: border-box !important;
                  padding: 6px 0px !important;
                  border-radius: 15px !important;
                  -webkit-backdrop-filter: blur(10.5px) !important;
                  backdrop-filter: blur(10.5px) !important;
                  -webkit-box-shadow: 0 2px 4px 0 rgba(39, 43, 49, 0.2) !important;
                  -moz-box-shadow: 0 2px 4px 0 rgba(39, 43, 49, 0.2) !important;
                  box-shadow: 0 2px 4px 0 rgba(39, 43, 49, 0.2) !important;
                  background-color: #fff !important;
              }

              .liner-color-picker .liner-color-circle, .liner-youtube-color-picker .liner-youtube-color-circle {
                  float: left !important;
                  width: 18px !important;
                  height: 18px !important;
                  margin: 0 5px !important;
                  border-radius: 50% !important;
              }

              .liner-color-lock, .liner-youtube-color-lock {
                  background-size: 6px 8px !important;
                  background-position: center !important;
                  background-repeat: no-repeat !important;
                  background-image: url(data:image/png;base64,) !important;
              }

              .liner-color-picker .liner-color-circle.liner-color-yellow, .liner-youtube-color-picker .liner-youtube-color-circle.liner-youtube-color-yellow {
                  margin-left: 11px !important;
              }

              .liner-color-setting, .liner-youtube-color-setting {
                  background-repeat: no-repeat !important;
                  background-size: contain !important;
                  background-position: center !important;
                  background-image: url(data:image/png;base64,) !important;
              }

              .liner-color-yellow {
                background-color: #FFFF83;
              }

              .liner-color-green {
                background-color: #A6FFE9;
              }

              .liner-color-orange {
                background-color: #FFC7BA;
              }

              .liner-color-violet {
                background-color: #D9C3FF;
              }

              .liner-color-blue {
                background-color: #B8EEFF;
              }

              .liner-color-pink {
                background-color: #FFD0EF;
              }

              .liner-upload-pdf-btn {
                  position: fixed;
                  right: 17px;
                  top: 61px;
                  width: 40px;
                  height: 40px;
                  background-image: url(data:image/png;base64,);
                  background-size: contain;
                  border-radius: 20px;
                  cursor: pointer;
                  -webkit-box-shadow: 0 2px 8px 0 rgba(39, 43, 49, 0.3);
                  -moz-box-shadow: 0 2px 8px 0 rgba(39, 43, 49, 0.3);
                  box-shadow: 0 2px 8px 0 rgba(39, 43, 49, 0.3);
                  transition: all 0.2s !important;
                  z-index: 999999999 !important;
              }

              .liner-upload-pdf-btn.disabled {
                  opacity: 0.5;
                  cursor: auto;
                  -webkit-box-shadow: 0 2px 4px 0 rgba(0, 0, 0, 0.2);
                  -moz-box-shadow: 0 2px 4px 0 rgba(0, 0, 0, 0.2);
                  box-shadow: 0 2px 4px 0 rgba(0, 0, 0, 0.2);
                  cursor: progress;
              }

              .liner-upload-pdf-tooltip {
                  position: fixed;
                  display: none;
                  font-family: system-ui !important;
                  right: 10px;
                  top: 105px;
                  padding: 4px;
                  border-radius: 3px;
                  background-color: #323639;
                  font-size: 10px;
                  font-weight: normal;
                  font-stretch: normal;
                  font-style: normal;
                  line-height: normal;
                  letter-spacing: normal;
                  text-align: center;
                  color: #fff;
                  z-index: 999999999 !important;
              }

              .liner-upload-pdf-banner {
                  display: none;
                  font-family: system-ui !important;
                  position: fixed;
                  top: 117px;
                  right: 16px;
                  background-color: #00bdb8;
                  color: #fff;
                  -webkit-box-shadow: 0 2px 8px 0 rgba(39, 43, 49, 0.3);
                  -moz-box-shadow: 0 2px 8px 0 rgba(39, 43, 49, 0.3);
                  box-shadow: 0 2px 8px 0 rgba(39, 43, 49, 0.3);
                  padding: 14px 12px;
                  font-size: 16px;
                  font-weight: bold;
                  font-stretch: normal;
                  font-style: normal;
                  line-height: normal;
                  letter-spacing: -0.4px;
                  border-radius: 16px 4px 16px 16px;
                  z-index: 999999999 !important;
              }

              .liner-upload-pdf-progress-bar {
                  background-color: #00bdb8 !important;
                  position: fixed;
                  top: 0;
                  left: 0;
                  width: 0%;
                  height: 4px;
                  z-index: 999999999 !important;
              }

              .liner-picked-search-result-bar {
                  position: absolute !important;
                  left: -20px !important;
                  background-color: #798AFF;
                  width: 4px;
              }

              .L-AIAnswer {
                background-color: #4058FF !important;  
              }

              .L-AIAnswerWrapper {
                position: relative;
              }

              .L-AIAnswer--text { 
                font-family: system-ui !important;
                position: absolute;
                left: 0;
                top: -4px;
                display: block;
                word-break: keep-all;
                padding: 4px 6px;
                display: flex;
                align-items: center;
                justify-content: center;
                background-color: #4058FF;
                font-style: normal;
                font-weight: 700;
                font-size: 11px;
                line-height: 13px;
                color: #fff;
                border-radius: 5px;
                white-space: nowrap;
              }

              .liner-picked-search-result-bar.liner-my-highlight {
                  background-color: #fff881 !important;
              }

              .liner-picked-search-result-link {
                  display: none !important;
                  /* display: inline-block !important; */
                  color: #00bdb8 !important;
                  margin-top: 4px !important;
                  text-decoration: none !important;
              }

              .liner-picked-search-result-link.liner-picked-search-result-link-scholar {
                  margin-top: 8px !important;
              }

              .liner-picked-search-result-link:hover {
                  color: #00a7a0 !important;
              }

              .liner-picked-search-result-link .liner-picked-search-result-arrow {
                  background-image: url(data:image/png;base64,) !important;
                  width: 5px !important;
                  height: 8px !important;
                  display: inline-block !important;
                  background-size: contain !important;
                  vertical-align: text-top !important;
                  margin-left: 4px !important;
                  margin-top: 4px !important;
              }

              .liner-picked-search-result-description {
                  display: none;
                  z-index: 9999999999999999999 !important;
                  width: 260px !important;
                  padding: 16px 20px !important;
                  position: absolute !important;
                  left: initial !important;
                  border-radius: 8px !important;
                  box-shadow: 0 10px 20px 0 rgba(39, 43, 49, 0.15) !important;
                  border: solid 1px #eef1f4;
                  background-color: #ffffff;
              }

              .liner-picked-search-result-description .liner-picked-search-result-description-title {
                  font-family: system-ui !important;
                  font-size: 14px !important;
                  font-weight: bold !important;
                  font-stretch: normal !important;
                  font-style: normal !important;
                  line-height: normal !important;
                  color: #969aa2;
                  margin: 0 !important;
                  margin-bottom: 8px !important;
              }

              .liner-picked-search-result-description .liner-picked-search-result-description-content {
                  font-family: system-ui !important;
                  font-size: 14px !important;
                  font-weight: normal !important;
                  font-stretch: normal !important;
                  font-style: normal !important;
                  line-height: 1.43 !important;
                  color: #52565d;
                  margin: 0 !important;
              }

              .liner-picked-search-result-information {
                  display: inline-block !important;
                  margin-top: 4px !important;
                  font-size: 12px !important;
                  font-weight: 400 !important;
                  font-stretch: normal !important;
                  font-style: normal !important;
                  line-height: normal !important;
                  color: #7c828f !important;
                  cursor: pointer !important;
              }

              .liner-picked-search-result-information.liner-my-highlight {
                  cursor: initial !important;
              }

              .liner-picked-search-result-information.liner-picked-search-result-information-scholar {
                  margin-top: 6px !important;
                  position: relative !important;
              }

              .liner-picked-search-result-information .liner-picked-search-result-information-icon {
                  position: relative !important;
                  top: 3px !important;
                  display: inline-block !important;
                  margin-right: 2px !important;
                  width: 14px !important;
                  height: 14px !important;
                  background-size: 14px 14px !important;
                  background-repeat: no-repeat !important;
                  background-image: url(data:image/png;base64,) !important;
              }

              .liner-pdf-highlight-badge {
                  display: inline-block !important;
                  cursor: pointer !important;
                  background-color: #ffffff !important;
                  border: 1px solid #ebebeb !important;
                  border-radius: 2px !important;
                  padding: 0 11px 0 20px !important;
                  height: 14px !important;
                  line-height: 16px !important;
                  text-align: center !important;
                  font-weight: normal !important;
                  color: #4d5156 !important;
                  font-size: 10px !important;
                  letter-spacing: 0.75px !important;
                  position: relative !important;
                  top: -1px !important;
                  margin-left: 5px !important;
                  text-decoration: none !important;
              }

              .liner-pdf-highlight-badge.liner-pdf-highlight-badge-scholoar {
                  position: absolute !important;
                  top: 3px !important;
              }

              .liner-pdf-highlight-badge .liner-pdf-highlight-badge-icon {
                  display: inline-block !important;
                  background-image: url(data:image/png;base64,) !important;
                  background-repeat: no-repeat !important;
                  background-size: contain !important;
                  width: 14px !important;
                  height: 14px !important;
                  position: absolute !important;
                  left: 0 !important;
              }

              .liner-pdf-highlight-badge .liner-pdf-highlight-badge-arrow {
                  display: inline-block !important;
                  background-image: url(data:image/png;base64,) !important;
                  background-repeat: no-repeat !important;
                  background-size: 5px 7px !important;
                  background-position: center;
                  width: 11px !important;
                  height: 14px !important;
                  position: absolute !important;
                  right: 0 !important;
              }

              #snippet-pdf-button, #snippet_popover_container, #snippet_screenshot_edit, #snippet_screenshot, #snippet_sidebar_container, .snippet-img-button,
              #diigo-video-capture, #diigo-video-capture-wrapper, #diigolet-notice, #diigolet-dlg-sticky, #diigolet-csm, #diigo-chrome-installed, #diigo-pdf, #diigolet-chrome-css {
                  display: none !important;
              }

              .tF2Cxc, .exp-outline {
                  height: inherit !important;
              }

              .guider-button-prompt__button .artdeco-button__text {
                  height: 16px !important;
              }

              .lytb-highlighter-in-control-tooltip {
                  display: none;
                  position: absolute !important;
                  bottom: 58px;
                  z-index: 1000 !important;
              }
              .lytb-highlighter-in-control-tooltip span {
                  background-color: rgba(28,28,28,0.9) !important;
                  border-radius: 2px !important;
                padding: 5px 9px !important;
                  color: #eee !important;
                  font-weight: 500 !important;
                  line-height: 15px !important;
              }

              .lytb-highlighter-in-control-opt-out-tooltip {
                  display: none;
                  position: absolute !important;
                  bottom: 58px;
                  z-index: 1000 !important;
              }

              .lytb-highlighter-in-control-opt-out-tooltip span {
                  background-color: #080A0D !important;
                  border-radius: 9px !important;
                  padding: 5px 9px !important;
                  color: #eee !important;
                  font-weight: 500 !important;
                  line-height: 15px !important;
              }
              

              .lytb-summary-in-control-tooltip {
                  display: none;
                  position: absolute !important;
                  bottom: 51px;
                  z-index: 1000 !important;
              }

              .lytb-summary-in-control-tooltip span {
                  background-color: rgba(28,28,28,0.9) !important;
                  border-radius: 2px !important;
                  padding: 5px 9px !important;
                  color: #eee !important;
                  font-weight: 500 !important;
                  line-height: 15px !important;
              }

              ytd-thumbnail {
                  transition: background-color 0.3s !important;
              }

              .text-wrapper.style-scope.ytd-video-renderer {
                  transition: background-color 0.3s !important;
              }


              .ytd-video-renderer .picked-by-liner-users {
                  background-color: transparent !important;
              }

              .liner-rel {
                position: relative;
              }
