5 C1.7100000381469727,-15 3.3540000915527344,-14.713000297546387 4.886000156402588,-14.1850004196167"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_7554)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_7550)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_7546)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_7542)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_7535)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g></g></svg></div></div></bard-avatar><!----><!----></div><!----><div _ngcontent-ng-c2825300596="" class="response-container-content ng-tns-c2825300596-509 has-thoughts"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><div _ngcontent-ng-c2756684661="" class="response-content ng-tns-c2825300596-509"><!----><div _ngcontent-ng-c2756684661="" class="thoughts-container ng-star-inserted"><div _ngcontent-ng-c2756684661="" class="thoughts-content ng-star-inserted"><div _ngcontent-ng-c2756684661="" class="thoughts-wrapper"><!----><model-thoughts _ngcontent-ng-c2756684661="" data-test-id="model-thoughts" _nghost-ng-c3887673081="" class="ng-tns-c3887673081-511 ng-star-inserted" style="height: auto;"><div _ngcontent-ng-c3887673081="" xapautoid="" class="model-thoughts ng-tns-c3887673081-511"><div _ngcontent-ng-c3887673081="" class="thoughts-header ng-tns-c3887673081-511"><button _ngcontent-ng-c3887673081="" mat-button="" data-test-id="thoughts-header-button" class="mdc-button mat-mdc-button-base thoughts-header-button ng-tns-c3887673081-511 mat-mdc-button mat-unthemed" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" aria-controls="" aria-expanded="false" jslog="247951;track:generic_click,impression"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><span class="mdc-button__label"><div _ngcontent-ng-c3887673081="" class="thoughts-header-button-content animated-content"><div _ngcontent-ng-c3887673081="" role="status" class="thoughts-header-button-label ng-tns-c3887673081-511"><!----><span _ngcontent-ng-c3887673081="" class="ng-tns-c3887673081-511 ng-star-inserted">생각하는 과정 표시</span><!----></div><div _ngcontent-ng-c3887673081="" class="thoughts-header-button-icons ng-tns-c3887673081-511"><!----><mat-icon _ngcontent-ng-c3887673081="" role="img" fonticon="expand_more" class="mat-icon notranslate thoughts-header-button-icon ng-tns-c3887673081-511 google-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="expand_more"></mat-icon><!----></div></div></span><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button></div><!----><!----></div></model-thoughts><!----></div><!----></div><!----></div><!----><!----><!----><!----><!----><!----><!----><h2 _ngcontent-ng-c2756684661="" class="cdk-visually-hidden screen-reader-model-response-label ng-star-inserted">Gemini의 응답</h2><!----><!----><structured-content-container _ngcontent-ng-c2756684661="" class="model-response-text has-thoughts processing-state-visible enable-2026q1-formatting-improvements ng-star-inserted" _nghost-ng-c155512926="" style="height: auto;"><div _ngcontent-ng-c155512926="" class="container"><message-content _ngcontent-ng-c155512926="" _nghost-ng-c3553714228="" id="message-content-id-r_ebdca6dc53dc6546" class="ng-star-inserted" style=""><div _ngcontent-ng-c3553714228="" inline-copy-host="" class="markdown markdown-main-panel stronger enable-updated-hr-color" id="model-response-message-contentr_ebdca6dc53dc6546" aria-live="off" aria-busy="false" dir="ltr" style="--animation-duration: 400ms; --fade-animation-function: ease-out;"><p data-path-to-node="0">아하, 예전에 다운로드해 두셨던 게 <code data-path-to-node="0" data-index-in-node="20">llama3</code>가 아니라 다른 모델(예: <code data-path-to-node="0" data-index-in-node="41">llama2</code>, <code data-path-to-node="0" data-index-in-node="49">gemma</code>, 혹은 한국어 특화 모델)이었거나, 로컬에 있는 모델의 버전이 너무 옛날 것이라 최신 버전으로 갱신(Update)하느라 새로 다운로드를 받고 있는 것일 확률이 높습니다!</p><p data-path-to-node="1">Ollama는 <code data-path-to-node="1" data-index-in-node="8">ollama run 모델명</code>을 쳤을 때 내 PC에 그 이름과 정확히 일치하는 모델이 없으면 자동으로 새로 다운로드를 시작하거든요.</p><p data-path-to-node="2">지금 바로 이렇게 대처해 보세요!</p><h3 data-path-to-node="3">🛑 1. 일단 다운로드 취소 &amp; 내 모델 확인하기</h3><p data-path-to-node="4">지금 다운로드 중인 터미널 창에서 키보드의 <b data-path-to-node="4" data-index-in-node="24"><code data-path-to-node="4" data-index-in-node="24">Ctrl + C</code></b> 를 눌러서 다운로드를 멈춰주세요.</p><p data-path-to-node="5">그리고 아래 명령어를 쳐서 <b data-path-to-node="5" data-index-in-node="15">현재 내 PC에 진짜로 설치되어 있는 모델 리스트</b>를 확인해 봅니다.</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><code-block _nghost-ng-c1154083104="" class="ng-tns-c1154083104-607 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c1154083104="" class="code-block ng-tns-c1154083104-607 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_ebdca6dc53dc6546&quot;,&quot;c_f64d2bbd82481a33&quot;,null,&quot;rc_1d3d74900d4f9f94&quot;,null,null,&quot;ko&quot;,null,1,null,null,1,1]]" data-hveid="5" style="display: block;"><div _ngcontent-ng-c1154083104="" class="code-block-decoration header-formatted gds-title-s ng-tns-c1154083104-607 ng-star-inserted" style=""><span _ngcontent-ng-c1154083104="" class="ng-tns-c1154083104-607">Bash</span><div _ngcontent-ng-c1154083104="" class="buttons ng-tns-c1154083104-607 ng-star-inserted"><button _ngcontent-ng-c1154083104="" aria-label="코드 다운로드" mat-icon-button="" mattooltip="코드 다운로드" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger download-button ng-tns-c1154083104-607 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered=""><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c1154083104="" role="img" fonticon="download" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="download"></mat-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----><!----><!----><!----><button _ngcontent-ng-c1154083104="" aria-label="코드 복사" mat-icon-button="" mattooltip="코드 복사" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c1154083104-607 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_ebdca6dc53dc6546&quot;,&quot;c_f64d2bbd82481a33&quot;,null,&quot;rc_1d3d74900d4f9f94&quot;,null,null,&quot;ko&quot;,null,1,null,null,1,1]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c1154083104="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----><!----></div><!----><!----></div><!----><div _ngcontent-ng-c1154083104="" class="formatted-code-block-internal-container ng-tns-c1154083104-607"><div _ngcontent-ng-c1154083104="" class="animated-opacity ng-tns-c1154083104-607"><!----><pre _ngcontent-ng-c1154083104="" class="ng-tns-c1154083104-607"><code _ngcontent-ng-c1154083104="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c1154083104-607">ollama list
</code></pre><!----></div></div></div><!----><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><h3 data-path-to-node="7">🎯 2. 결과에 따른 다음 행동 결정</h3><p data-path-to-node="8"><b data-path-to-node="8" data-index-in-node="0">👉 경우의 수 A: 리스트에 다른 모델이 있는 경우 (예: <code data-path-to-node="8" data-index-in-node="34">gemma</code>, <code data-path-to-node="8" data-index-in-node="41">llama2</code> 등)</b>
내 PC에 이미 깔려있는 모델을 그대로 쓰시면 됩니다!</p><ol start="1" data-path-to-node="9"><li><p data-path-to-node="9,0,0"><code data-path-to-node="9,0,0" data-index-in-node="0">ollama list</code> 결과의 <code data-path-to-node="9,0,0" data-index-in-node="16">NAME</code> 란에 적힌 이름(예: <code data-path-to-node="9,0,0" data-index-in-node="33">gemma:7b</code>)을 복사합니다.</p></li><li><p data-path-to-node="9,1,0">터미널에서 <code data-path-to-node="9,1,0" data-index-in-node="6">ollama run gemma:7b</code> (가진 모델명) 을 쳐서 띄워둡니다.</p></li><li><p data-path-to-node="9,2,0"><b data-path-to-node="9,2,0" data-index-in-node="0">스프링 부트 코드</b>로 돌아가서 변수명을 내가 가진 모델명으로 똑같이 바꿔줍니다.
<code data-path-to-node="9,2,0" data-index-in-node="44">private final String OLLAMA_MODEL = "gemma:7b";</code></p></li></ol><p data-path-to-node="10"><b data-path-to-node="10" data-index-in-node="0">👉 경우의 수 B: 아무것도 없거나, 이참에 <code data-path-to-node="10" data-index-in-node="26">llama3</code>를 쓰고 싶은 경우</b>
최신 모델인 <code data-path-to-node="10" data-index-in-node="50">llama3</code>가 똑똑하긴 합니다!
방금 하셨던 것처럼 <code data-path-to-node="10" data-index-in-node="79">ollama run llama3</code> 를 다시 치고, 커피 한 잔 드시면서 5~6분 정도 다운로드가 끝날 때까지 기다려 주시면 됩니다. (한 번만 다운받으면 다음부터는 1초 만에 켜집니다.)</p><p data-path-to-node="11">어떤 모델을 가지고 계신지 <code data-path-to-node="11" data-index-in-node="15">ollama list</code> 쳐보시고 이름 한 번 확인해 보세요!</p></div></message-content><!----></div></structured-content-container><!----><!----><!----><div _ngcontent-ng-c2756684661="" class="response-footer complete has-thoughts gap"><!----><!----><!----><sources-list _ngcontent-ng-c2756684661="" class="sources-list ng-star-inserted"><!----></sources-list><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><sensitive-memories-banner _ngcontent-ng-c2756684661="" _nghost-ng-c3776646686="" class="ng-star-inserted"><!----></sensitive-memories-banner><!----><!----><!----></div></div><div _ngcontent-ng-c2825300596="" class="response-container-footer ng-tns-c2825300596-509 ng-star-inserted"><!----><!----><!----><message-actions _ngcontent-ng-c2756684661="" footer="" _nghost-ng-c3779276655="" class="ng-tns-c3779276655-510 hide-action-bar ng-tns-c2825300596-509 ng-star-inserted"><div _ngcontent-ng-c3779276655="" class="actions-container-v2 ng-tns-c3779276655-510"><div _ngcontent-ng-c3779276655="" class="buttons-container-v2 ng-tns-c3779276655-510 ng-star-inserted"><!----><thumb-up-button _ngcontent-ng-c3779276655="" _nghost-ng-c870918567="" class="ng-tns-c3779276655-510 ng-star-inserted"><!----><button _ngcontent-ng-c870918567="" mat-icon-button="" mattooltip="대답이 마음에 들어요" aria-label="대답이 마음에 들어요" data-test-id="thumb-up-button" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger icon-button mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" aria-pressed="false" jslog="173913;track:generic_click,impression;BardVeMetadataKey:[