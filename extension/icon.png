ible;"><defs><clippath id="__lottie_element_7955"><rect width="32" height="32" x="0" y="0"></rect></clippath><lineargradient id="__lottie_element_7959" spreadMethod="pad" gradientUnits="userSpaceOnUse"><stop></stop><stop></stop><stop></stop><stop></stop><stop></stop></lineargradient><lineargradient id="__lottie_element_7966" spreadMethod="pad" gradientUnits="userSpaceOnUse"><stop></stop><stop></stop><stop></stop></lineargradient><lineargradient id="__lottie_element_7970" spreadMethod="pad" gradientUnits="userSpaceOnUse"><stop></stop><stop></stop><stop></stop></lineargradient><lineargradient id="__lottie_element_7974" spreadMethod="pad" gradientUnits="userSpaceOnUse"><stop></stop><stop></stop><stop></stop></lineargradient><lineargradient id="__lottie_element_7978" spreadMethod="pad" gradientUnits="userSpaceOnUse"><stop></stop><stop></stop><stop></stop><stop></stop><stop></stop></lineargradient><lineargradient id="__lottie_element_7982" spreadMethod="pad" gradientUnits="userSpaceOnUse" x1="-16" y1="0" x2="16" y2="0"><stop offset="0%" stop-color="rgb(49,134,255)"></stop><stop offset="50%" stop-color="rgb(49,134,255)"></stop><stop offset="100%" stop-color="rgb(49,134,255)"></stop><stop offset="100%" stop-color="rgb(49,134,255)"></stop><stop offset="100%" stop-color="rgb(49,134,255)"></stop></lineargradient></defs><g clip-path="url(#__lottie_element_7955)"><g transform="matrix(1,0,0,1,16,16)" opacity="1" style="display: block;"><g opacity="1" transform="matrix(1,0,0,1,0,0)"><path stroke="url(#__lottie_element_7982)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4" stroke-opacity="1" stroke-width="2" d=" M-4.383999824523926,-14.347999572753906 C-2.996999979019165,-14.772000312805176 -1.524999976158142,-15 0,-15 C0,-15 0,-15 0,-15 C1.7100000381469727,-15 3.3540000915527344,-14.713000297546387 4.886000156402588,-14.1850004196167"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_7978)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_7974)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_7970)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_7966)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_7959)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g></g></svg></div></div></bard-avatar><!----><!----></div><!----><div _ngcontent-ng-c2825300596="" class="response-container-content ng-tns-c2825300596-541 has-thoughts"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><div _ngcontent-ng-c2756684661="" class="response-content ng-tns-c2825300596-541"><!----><div _ngcontent-ng-c2756684661="" class="thoughts-container ng-star-inserted"><div _ngcontent-ng-c2756684661="" class="thoughts-content ng-star-inserted"><div _ngcontent-ng-c2756684661="" class="thoughts-wrapper"><!----><model-thoughts _ngcontent-ng-c2756684661="" data-test-id="model-thoughts" _nghost-ng-c3887673081="" class="ng-tns-c3887673081-543 ng-star-inserted" style="height: auto;"><div _ngcontent-ng-c3887673081="" xapautoid="" class="model-thoughts ng-tns-c3887673081-543"><div _ngcontent-ng-c3887673081="" class="thoughts-header ng-tns-c3887673081-543"><button _ngcontent-ng-c3887673081="" mat-button="" data-test-id="thoughts-header-button" class="mdc-button mat-mdc-button-base thoughts-header-button ng-tns-c3887673081-543 mat-mdc-button mat-unthemed" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" aria-controls="" aria-expanded="false" jslog="247951;track:generic_click,impression"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><span class="mdc-button__label"><div _ngcontent-ng-c3887673081="" class="thoughts-header-button-content animated-content"><div _ngcontent-ng-c3887673081="" role="status" class="thoughts-header-button-label ng-tns-c3887673081-543"><!----><span _ngcontent-ng-c3887673081="" class="ng-tns-c3887673081-543 ng-star-inserted">생각하는 과정 표시</span><!----></div><div _ngcontent-ng-c3887673081="" class="thoughts-header-button-icons ng-tns-c3887673081-543"><!----><mat-icon _ngcontent-ng-c3887673081="" role="img" fonticon="expand_more" class="mat-icon notranslate thoughts-header-button-icon ng-tns-c3887673081-543 google-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="expand_more"></mat-icon><!----></div></div></span><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button></div><!----><!----></div></model-thoughts><!----></div><!----></div><!----></div><!----><!----><!----><!----><!----><!----><!----><h2 _ngcontent-ng-c2756684661="" class="cdk-visually-hidden screen-reader-model-response-label ng-star-inserted">Gemini의 응답</h2><!----><!----><structured-content-container _ngcontent-ng-c2756684661="" class="model-response-text has-thoughts processing-state-visible enable-2026q1-formatting-improvements ng-star-inserted" _nghost-ng-c155512926="" style="height: auto;"><div _ngcontent-ng-c155512926="" class="container"><message-content _ngcontent-ng-c155512926="" _nghost-ng-c3553714228="" id="message-content-id-r_a7051f61af8785f3" class="ng-star-inserted" style=""><div _ngcontent-ng-c3553714228="" inline-copy-host="" class="markdown markdown-main-panel stronger enable-updated-hr-color" id="model-response-message-contentr_a7051f61af8785f3" aria-live="off" aria-busy="false" dir="ltr" style="--animation-duration: 400ms; --fade-animation-function: ease-out;"><p data-path-to-node="0">아이고 ㅋㅋㅋㅋ 이 녀석이 이미 완벽하게 고쳐진 문장이 들어오니까, "제가 일을 안 한 게 아니라 이미 완벽해서 냅둔 겁니다!" 하고 굳이 변명을 해버리네요.</p><p data-path-to-node="1">이게 챗봇형 AI들의 고질병인 '오지랖(Over-explanation)'입니다. 자기가 왜 이런 결과를 냈는지 자꾸 사용자한테 설명하려고 들죠.</p><p data-path-to-node="2">이 오지랖을 완벽하게 차단하려면, "이미 완벽한 문장이 들어왔을 때 네가 해야 할 행동"에 대한 예시(정답지)를 하나 더 추가해주면 됩니다.</p><p data-path-to-node="3">프롬프트에 [예시 2: 이미 완벽할 때]를 추가해서 AI의 입을 완전히 꿰매버리겠습니다!</p><h3 data-path-to-node="4">🛠️ MailApiController.java 수정 (오지랖 원천 차단)</h3><p data-path-to-node="5"><code data-path-to-node="5" data-index-in-node="0">systemPrompt</code>를 아래 코드로 교체해 주세요. 이번엔 절대 딴소리 못 할 겁니다.</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><code-block _nghost-ng-c1154083104="" class="ng-tns-c1154083104-616 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c1154083104="" class="code-block ng-tns-c1154083104-616 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_a7051f61af8785f3&quot;,&quot;c_f64d2bbd82481a33&quot;,null,&quot;rc_f87dd1cd5200ceee&quot;,null,null,&quot;ko&quot;,null,1,null,null,1,0]]" data-hveid="5" style="display: block;"><div _ngcontent-ng-c1154083104="" class="code-block-decoration header-formatted gds-title-s ng-tns-c1154083104-616 ng-star-inserted" style=""><span _ngcontent-ng-c1154083104="" class="ng-tns-c1154083104-616">Java</span><div _ngcontent-ng-c1154083104="" class="buttons ng-tns-c1154083104-616 ng-star-inserted"><button _ngcontent-ng-c1154083104="" aria-label="코드 다운로드" mat-icon-button="" mattooltip="코드 다운로드" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger download-button ng-tns-c1154083104-616 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered=""><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c1154083104="" role="img" fonticon="download" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="download"></mat-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----><!----><!----><!----><button _ngcontent-ng-c1154083104="" aria-label="코드 복사" mat-icon-button="" mattooltip="코드 복사" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c1154083104-616 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_a7051f61af8785f3&quot;,&quot;c_f64d2bbd82481a33&quot;,null,&quot;rc_f87dd1cd5200ceee&quot;,null,null,&quot;ko&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c1154083104="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----><!----></div><!----><!----></div><!----><div _ngcontent-ng-c1154083104="" class="formatted-code-block-internal-container ng-tns-c1154083104-616"><div _ngcontent-ng-c1154083104="" class="animated-opacity ng-tns-c1154083104-616"><!----><pre _ngcontent-ng-c1154083104="" class="ng-tns-c1154083104-616"><code _ngcontent-ng-c1154083104="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c1154083104-616"><span class="hljs-comment">// ... 기존 코드 ...</span>
    <span class="hljs-meta">@PostMapping("/correct")</span>
    <span class="hljs-function"><span class="hljs-keyword">public</span> ResponseEntity&lt;String&gt; <span class="hljs-title">correctMail</span><span class="hljs-params">(<span class="hljs-meta">@RequestBody</span> MailRequest request)</span> </span>{
        System.out.println(<span class="hljs-string">"📬 [AI 서버] 익스텐션 본문 도착! Ollama로 교정 요청을 보냅니다..."</span>);

        <span class="hljs-comment">// ✨ 핵심: '이미 완벽한 경우'에 대한 규칙과 예시를 추가하여 변명을 원천 차단합니다.</span>
        String systemPrompt = <span class="hljs-string">"당신은 한국 대기업의 비즈니스 텍스트 교정 전문가입니다.\n"</span>
                            + <span class="hljs-string">"입력된 HTML 문서의 태그 구조를 100% 유지한 채, 텍스트 내용만 격식 있는 '비즈니스 하십시오체(다나까체)'로 교정하세요.\n\n"</span>
                            + <span class="hljs-string">"[필수 지침]\n"</span>
                            + <span class="hljs-string">"1. 어조: '~요', '~까?' 등 구어체는 '~습니다', '~바랍니다', '~안녕하십니까'로 완벽히 수정.\n"</span>
                            + <span class="hljs-string">"2. 용어: 오늘-&gt;금일, 내일-&gt;명일, 어제-&gt;작일, 보내다-&gt;송부하다/전달하다.\n"</span>
                            + <span class="hljs-string">"3. 내용 보존: 사용자가 작성한 원본의 인사말이나 핵심 내용은 절대 지우지 말 것.\n"</span>
                            + <span class="hljs-string">"4. 무반응 원칙: 이미 완벽한 비즈니스 톤이어서 수정할 곳이 없더라도, 절대 이유를 설명하지 말고 '원본을 그대로' 출력할 것.\n"</span>
                            + <span class="hljs-string">"5. 절대 금지: AI 너 자신의 대답, 부연 설명('교정 결과는~' 등), 마크다운 기호(```html 등)는 절대 출력 금지.\n\n"</span>
                            + <span class="hljs-string">"[교정 예시 1: 수정이 필요한 경우]\n"</span>
                            + <span class="hljs-string">"입력: &lt;p&gt;안녕하시구료, &lt;b&gt;오늘&lt;/b&gt; 무슨 날인지 알려줄수 있습니까?&lt;/p&gt;\n"</span>
                            + <span class="hljs-string">"출력: &lt;p&gt;안녕하십니까, &lt;b&gt;금일&lt;/b&gt; 무슨 날인지 공유 부탁드립니다.&lt;/p&gt;\n\n"</span>
                            + <span class="hljs-string">"[교정 예시 2: 이미 완벽한 경우 (절대 부연 설명 금지)]\n"</span>
                            + <span class="hljs-string">"입력: &lt;p&gt;안녕하십니까, 금일 결재 문서를 송부하였습니다. 확인 부탁드립니다.&lt;/p&gt;\n"</span>
                            + <span class="hljs-string">"출력: &lt;p&gt;안녕하십니까, 금일 결재 문서를 송부하였습니다. 확인 부탁드립니다.&lt;/p&gt;"</span>;

        String prompt = request.text();
<span class="hljs-comment">// ... (이하 기존 코드와 동일) ...</span>
</code></pre><!----></div></div></div><!----><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><h3 data-path-to-node="7">🔄 최종의 최종 테스트!</h3><p data-path-to-node="8">다시 스프링 부트 껐다 켜시고, 똑같이 <b data-path-to-node="8" data-index-in-node="22">이미 교정된 완벽한 문장</b>을 한 번 더 돌려보세요.</p><p data-path-to-node="9">이번에는 자기가 할 일이 없다는 걸 눈치채고, 입 꾹 닫은 채로 <b data-path-to-node="9" data-index-in-node="36">방금 넣었던 문장 그대로(변명 없이)</b> 조용히 뱉어낼 것입니다!</p><p data-path-to-node="10">진짜 실무에 배포하려면 이런 엣지 케이스(Edge Case)들을 하나씩 잡아가는 과정이 필수입니다. 이거 통과하면 진짜 배포 준비 완료입니다! 확인해 보시죠! 😎</p></div></message-content><!----></div></structured-content-container><!----><!----><!----><div _ngcontent-ng-c2756684661="" class="response-footer complete has-thoughts gap"><!----><!----><!----><sources-list _ngcontent-ng-c2756684661="" class="sources-list ng-star-inserted"><!----></sources-list><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><sensitive-memories-banner _ngcontent-ng-c2756684661="" _nghost-ng-c3776646686="" class="ng-star-inserted"><!----></sensitive-memories-banner><!----><!----><!----></div></div><div _ngcontent-ng-c2825300596="" class="response-container-footer ng-tns-c2825300596-541 ng-star-inserted"><!----><!----><!----><message-actions _ngcontent-ng-c2756684661="" footer="" _nghost-ng-c3779276655="" class="ng-tns-c3779276655-542 hide-action-bar ng-tns-c2825300596-541 ng-star-inserted"><div _ngcontent-ng-c3779276655="" class="actions-containe