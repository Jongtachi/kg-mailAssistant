uery-text-line ng-star-inserted"><!----><br _ngcontent-ng-c120227718="" class="ng-star-inserted"><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">         if (letterDiv) { <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">             alert("🎉 [궁극기 성공] 에디터 본문 추출 완벽 성공!\n\n" + letterDiv.innerText); <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">         } else { <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">             alert("HTML은 빼왔는데 letter 영역이 없습니다."); <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">         } <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">     } <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted"> }); <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted"><!----><br _ngcontent-ng-c120227718="" class="ng-star-inserted"><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted"> // --- 3. 버튼 클릭 시 스파이 투하 --- <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted"> aiButton.addEventListener("click", () =&gt; { <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted"><!----><br _ngcontent-ng-c120227718="" class="ng-star-inserted"><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">     // 현실 우주(실제 그룹웨어 페이지)로 투하할 스크립트 폭탄을 만듭니다. <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">     const script = document.createElement("script"); <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">     script.textContent = ` <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">         try { <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">             // 그룹웨어가 쓰고 있는 DEXT5 에디터의 엔진을 직접 호출합니다! <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">             // 화면에 있는 첫 번째 에디터의 전체 HTML 코드를 가져옵니다. <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">             var editorId = DEXT5.getEditors()[0].ID; <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">             var fullHtml = DEXT5.getBodyValue(editorId); <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">              <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">             // 가져온 HTML 코드를 익스텐션(우리)에게 무전으로 쏩니다. <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">             window.postMessage({ type: "DEXT5_DATA", html: fullHtml }, "*"); <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">         } catch(e) { <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">             alert("스파이 침투 실패: DEXT5 에디터 엔진을 찾을 수 없습니다."); <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">             console.error(e); <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">         } <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">     `; <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted"><!----><br _ngcontent-ng-c120227718="" class="ng-star-inserted"><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">     // 페이지에 폭탄을 심자마자(appendChild) 코드가 실행되고, 곧바로 흔적을 지웁니다(remove).    document.body.appendChild(script); <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted">     script.remove(); <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted"> }); <!----><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted"><!----><br _ngcontent-ng-c120227718="" class="ng-star-inserted"><!----><!----></p><p _ngcontent-ng-c120227718="" class="query-text-line ng-star-inserted"> 이렇게 나오네  <!----><!----><!----></p><!----></div><button _ngcontent-ng-c120227718="" mat-icon-button="" aria-label="펼치기" mattooltip="텍스트 펼치기" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger expand-button mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="224552;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_0b87dbb598d384c2&quot;,&quot;c_f64d2bbd82481a33&quot;,null,null,null,null,null,null,1,null,null,null,1]];mutable:true" aria-describedby="cdk-describedby-message-ng-1-187" cdk-describedby-host="ng-1"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c120227718="" role="img" fonticon="expand_more" class="mat-icon notranslate gds-icon-l google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="expand_more"></mat-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----><!----><!----><!----></span><!----><!----></span><!----><!----><!----><!----></div><!----><!----><!----><!----><!----></div><!----><!----><!----><!----></user-query-content></span></user-query><!----><!----><!----><model-response _ngcontent-ng-c250877782="" _nghost-ng-c2756684661="" class="ng-star-inserted"><div _ngcontent-ng-c2