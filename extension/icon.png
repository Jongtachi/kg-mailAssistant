on-ripple" aria-controls="" aria-expanded="false" jslog="247951;track:generic_click,impression"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><span class="mdc-button__label"><div _ngcontent-ng-c3887673081="" class="thoughts-header-button-content animated-content"><div _ngcontent-ng-c3887673081="" role="status" class="thoughts-header-button-label ng-tns-c3887673081-480"><!----><span _ngcontent-ng-c3887673081="" class="ng-tns-c3887673081-480 ng-star-inserted">생각하는 과정 표시</span><!----></div><div _ngcontent-ng-c3887673081="" class="thoughts-header-button-icons ng-tns-c3887673081-480"><!----><mat-icon _ngcontent-ng-c3887673081="" role="img" fonticon="expand_more" class="mat-icon notranslate thoughts-header-button-icon ng-tns-c3887673081-480 google-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="expand_more"></mat-icon><!----></div></div></span><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button></div><!----><!----></div></model-thoughts><!----></div><!----></div><!----></div><!----><!----><!----><!----><!----><!----><!----><h2 _ngcontent-ng-c2756684661="" class="cdk-visually-hidden screen-reader-model-response-label ng-star-inserted">Gemini의 응답</h2><!----><!----><structured-content-container _ngcontent-ng-c2756684661="" class="model-response-text has-thoughts processing-state-visible enable-2026q1-formatting-improvements ng-star-inserted" _nghost-ng-c155512926="" style="height: auto;"><div _ngcontent-ng-c155512926="" class="container"><message-content _ngcontent-ng-c155512926="" _nghost-ng-c3553714228="" id="message-content-id-r_6f0188dc2a849ecb" class="ng-star-inserted" style=""><div _ngcontent-ng-c3553714228="" inline-copy-host="" class="markdown markdown-main-panel stronger enable-updated-hr-color" id="model-response-message-contentr_6f0188dc2a849ecb" aria-live="off" aria-busy="false" dir="ltr" style="--animation-duration: 400ms; --fade-animation-function: ease-out;"><p data-path-to-node="0">정말 끈질긴 녀석이네요! ㅎㅎ 오히려 오기가 생깁니다.</p><p data-path-to-node="1">ID로 찾는 것도 안 되고, 에디터 API 엔진을 부르는 것도 안 먹힌다면 이유는 하나입니다.
에디터가 우리가 생각하는 것보다 <b data-path-to-node="1" data-index-in-node="71">더 깊숙한 곳(예: iframe 안의 iframe)에 겹겹이 숨어있거나, 페이지 로딩 시점에 따라 구조가 요동치고 있는 것</b>입니다.</p><p data-path-to-node="2">이럴 때는 복잡하게 머리 쓰지 않고, 가장 원초적이고 무식하지만 <b data-path-to-node="2" data-index-in-node="36">절대 실패할 수 없는 방법</b>을 써야 합니다.
바로 "현재 화면에 존재하는 모든 창, 그리고 그 창 안에 있는 창까지 꼬리를 물고 끝까지 파고들어서(재귀 탐색) <code data-path-to-node="2" data-index-in-node="124">div[name="letter"]</code>를 찾아내는 불도저식 탐색"입니다!</p><p data-path-to-node="3"><code data-path-to-node="3" data-index-in-node="0">content.js</code>를 아래 코드로 변경해 주세요.</p><h3 data-path-to-node="4">🛠️ content.js 최종본 (불도저식 끝장 탐색)</h3><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><code-block _nghost-ng-c1154083104="" class="ng-tns-c1154083104-601 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c1154083104="" class="code-block ng-tns-c1154083104-601 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_6f0188dc2a849ecb&quot;,&quot;c_f64d2bbd82481a33&quot;,null,&quot;rc_cb02edd23f048d2b&quot;,null,null,&quot;ko&quot;,null,1,null,null,1,1]]" data-hveid="5" style="display: block;"><div _ngcontent-ng-c1154083104="" class="code-block-decoration header-formatted gds-title-s ng-tns-c1154083104-601 ng-star-inserted" style=""><span _ngcontent-ng-c1154083104="" class="ng-tns-c1154083104-601">JavaScript</span><div _ngcontent-ng-c1154083104="" class="buttons ng-tns-c1154083104-601 ng-star-inserted"><button _ngcontent-ng-c1154083104="" aria-label="코드 다운로드" mat-icon-button="" mattooltip="코드 다운로드" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger download-button ng-tns-c1154083104-601 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered=""><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c1154083104="" role="img" fonticon="download" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="download"></mat-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----><!----><!----><!----><button _ngcontent-ng-c1154083104="" aria-label="코드 복사" mat-icon-button="" mattooltip="코드 복사" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c1154083104-601 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_6f0188dc2a849ecb&quot;,&quot;c_f64d2bbd82481a33&quot;,null,&quot;rc_cb02edd23f048d2b&quot;,null,null,&quot;ko&quot;,null,1,null,null,1,1]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c1154083104="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----><!----></div><!----><!----></div><!----><div _ngcontent-ng-c1154083104="" class="formatted-code-block-internal-container ng-tns-c1154083104-601"><div _ngcontent-ng-c1154083104="" class="animated-opacity ng-tns-c1154083104-601"><!----><pre _ngcontent-ng-c1154083104="" class="ng-tns-c1154083104-601"><code _ngcontent-ng-c1154083104="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c1154083104-601"><span class="hljs-built_in">console</span>.log(<span class="hljs-string">"🚀 [불도저 탐색 모드] AI 버튼 로딩 완료"</span>);

<span class="hljs-comment">// --- 1. 버튼 만들기 ---</span>
<span class="hljs-keyword">const</span> aiButton = <span class="hljs-built_in">document</span>.createElement(<span class="hljs-string">"button"</span>);
aiButton.innerHTML = <span class="hljs-string">"🤖 AI 교정"</span>;
aiButton.style.position = <span class="hljs-string">"fixed"</span>;
aiButton.style.bottom = <span class="hljs-string">"30px"</span>;
aiButton.style.right = <span class="hljs-string">"30px"</span>;
aiButton.style.padding = <span class="hljs-string">"15px 20px"</span>;
aiButton.style.backgroundColor = <span class="hljs-string">"#0056b3"</span>;
aiButton.style.color = <span class="hljs-string">"white"</span>;
aiButton.style.border = <span class="hljs-string">"none"</span>;
aiButton.style.borderRadius = <span class="hljs-string">"50px"</span>;
aiButton.style.boxShadow = <span class="hljs-string">"0 4px 10px rgba(0,0,0,0.3)"</span>;
aiButton.style.fontSize = <span class="hljs-string">"16px"</span>;
aiButton.style.fontWeight = <span class="hljs-string">"bold"</span>;
aiButton.style.cursor = <span class="hljs-string">"pointer"</span>;
aiButton.style.zIndex = <span class="hljs-string">"9999"</span>;
<span class="hljs-built_in">document</span>.body.appendChild(aiButton);

<span class="hljs-comment">// --- 2. iframe의 바닥까지 파고드는 불도저 함수 ---</span>
<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">findLetterDiv</span>(<span class="hljs-params">doc</span>) </span>{
    <span class="hljs-comment">// 1단계: 지금 쳐다보고 있는 문서(doc)에 letter가 있는지 확인합니다.</span>
    <span class="hljs-keyword">let</span> letter = doc.querySelector(<span class="hljs-string">'div[name="letter"]'</span>);
    <span class="hljs-keyword">if</span> (letter) <span class="hljs-keyword">return</span> letter; <span class="hljs-comment">// 찾으면 바로 반환!</span>

    <span class="hljs-comment">// 2단계: 없으면? 현재 문서에 있는 모든 iframe의 문을 강제로 엽니다.</span>
    <span class="hljs-keyword">let</span> iframes = doc.querySelectorAll(<span class="hljs-string">"iframe"</span>);
    <span class="hljs-keyword">for</span> (<span class="hljs-keyword">let</span> i = <span class="hljs-number">0</span>; i &lt; iframes.length; i++) {
        <span class="hljs-keyword">try</span> {
            <span class="hljs-keyword">let</span> iframeDoc = iframes[i].contentDocument || iframes[i].contentWindow.document;
            <span class="hljs-keyword">if</span> (iframeDoc) {
                <span class="hljs-comment">// 3단계: 문을 연 iframe 안쪽으로 불도저 함수를 다시 투입합니다! (재귀 호출)</span>
                <span class="hljs-keyword">let</span> foundInside = findLetterDiv(iframeDoc);
                <span class="hljs-keyword">if</span> (foundInside) <span class="hljs-keyword">return</span> foundInside; <span class="hljs-comment">// 안쪽에서 찾았으면 반환!</span>
            }
        } <span class="hljs-keyword">catch</span> (error) {
            <span class="hljs-comment">// 권한이 없어서 못 여는 광고성 iframe 등은 조용히 무시하고 넘어갑니다.</span>
            <span class="hljs-keyword">continue</span>;
        }
    }
    
    <span class="hljs-keyword">return</span> <span class="hljs-literal">null</span>; <span class="hljs-comment">// 바닥까지 다 뒤졌는데 없으면 null 반환</span>
}

<span class="hljs-comment">// --- 3. 버튼 클릭 시 불도저 출발 ---</span>
aiButton.addEventListener(<span class="hljs-string">"click"</span>, <span class="hljs-function">() =&gt;</span> {
    <span class="hljs-comment">// 가장 바깥쪽 전체 화면(document)부터 탐색을 시작합니다.</span>
    <span class="hljs-keyword">const</span> resultDiv = findLetterDiv(<span class="hljs-built_in">document</span>);

    <span class="hljs-keyword">if</span> (resultDiv) {
        alert(<span class="hljs-string">"🎉 [진짜 최종 성공] 불도저로 다 밀어서 찾아냈습니다!\n\n"</span> + resultDiv.innerText);
    } <span class="hljs-keyword">else</span> {
        alert(<span class="hljs-string">"🚨 끝까지 파고들었는데도 없습니다. (구조가 완전히 다르거나 접근이 완벽히 차단됨)"</span>);
    }
});
</code></pre><!----></div></div></div><!----><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="6"><i data-path-to-node="6" data-index-in-node="0">(참고: <code data-path-to-node="6" data-index-in-node="5">manifest.json</code>은 아까 수정하신 <code data-path-to-node="6" data-index-in-node="28">"world": "MAIN"</code> 이 포함된 상태 그대로 두시면 됩니다.)</i></p><h3 data-path-to-node="7">💡 (중요) 크롬 익스텐션 완전 새로고침 방법</h3><p data-path-to-node="8">가끔 크롬이 이전 코드를 물고 놔주지 않는 경우가 있습니다.</p><ol start="1" data-path-to-node="9"><li><p data-path-to-node="9,0,0"><code data-path-to-node="9,0,0" data-index-in-node="0">chrome://extensions/</code> 페이지로 가서 <b data-path-to-node="9,0,0" data-index-in-node="29">파란색 스위치를 껐다가 다시 켜주세요.</b> (완전 초기화)</p></li><li><p data-path-to-node="9,1,0">카드의 <b data-path-to-node="9,1,0" data-index-in-node="4">새로고침(🔄)</b> 버튼을 누릅니다.</p></li><li><p data-path-to-node="9,2,0">그룹웨어 <b data-path-to-node="9,2,0" data-index-in-node="5">메일 팝업창을 완전히 닫았다가 다시 열어주세요.</b> (F5 대신 창 자체를 다시 띄우기)</p></li></ol><p data-path-to-node="10">에디터에 글씨를 적고 [🤖 AI 교정] 버튼을 눌러보세요.
어디에 꽁꽁 숨겨져 있든 무조건 다 파헤쳐서 꺼내올 것입니다! 결과가 어떻게 나오는지 궁금하네요!</p></div></message-content><!----></div></structured-content-container><!----><!----><!----><div _ngcontent-ng-c2756684661="" class="response-footer complete has-thoughts gap"><!----><!----><!----><sources-list _ngcontent-ng-c2756684661="" class="sources-list ng-star-inserted"><!----></sources-list><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><sensitive-memories-banner _ngcontent-ng-c2756684661="" _nghost-ng-c3776646686="" class="ng-star-inserted"><!----></sensitive-memories-banner><!----><!----><!----></div></div><div _ngcontent-ng-c2825300596="" class="response-container-footer ng-tns-c2825300596-478 ng-star-inserted"><!----><!----><!----><message-actions _ngcontent-ng-c2756684661="" footer="" _nghost-ng-c3779276655="" class="ng-tns-c3779276655-479 hide-action-bar ng-tns-c2825300596-478 ng-star-inserted"><div _ngcontent-ng-c3779276655="" class="actions-container-v2 ng-tns-c3779276655-479"><div _ngcontent-ng-c3779276655="" class="buttons-container-v2 ng-tns-c3779276655-479 ng-star-inserted"><!----><thumb-up-button _ngcontent-ng-c3779276655="" _nghost-ng-c870918567="" class="ng-tns-c3779276655-479 ng-star-inserted"><!----><button _ngcontent-ng-c870918567="" mat-icon-button="" mattooltip="대답이 마음에 들어요" aria-label="대답이 마음에 들어요" data-test-id="thumb-up-button" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger icon-button mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" aria-pressed="false" jslog="173913;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_6f0188dc2a849ecb&quot;,&quot;c_f64d2bbd82481a33&quot;,null,&quot;rc_cb02edd23f048d2b&quot;,null,null,&quot;ko&quot;,null,1,null,null,1,1]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c870918567="" role="img" fonticon="thumb_up" class="mat-icon notranslate gds-icon-m google-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="thumb_up"></mat-icon><!----><div _ngcontent-ng-c870918567="" lottie-animation="" class="thumb-animation" hidden=""><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 96 96" width="96" height="96" preserveAspectRatio="xMidYMid meet" style="width: 100%; height: 100%; transform: translate3d(0px, 0px, 0px); content-visibility: visible;"><defs><clippath id="__lottie_element_7082"><rect width="96" height="96" x="0" y="0"></rect></clippath><mask id="__lottie_element_7086"><rect fill="#ffffff" width="96" height="96"></rect><path fill="#000000" clip-rule="nonzero" d=" M20.823999404907227,-50.45800018310547 C20.823999404907227,-50.45800018310547 -18.42799949645996,-40.75899887084961 -18.42799949645996,-40.75899887084961 C-18.42799949645996,-40.75899887084961 -20.881999969482422,-11.439000129699707 -20.881999969482422,-11.439000129699707 C-20.881999969482422,-11.439000129699707 13.111000061035156,-16.22100067138672 13.111000061035156,-16.22100067138672 C13.111000061035156,-16.22100067138672 20.823999404907227,-50.45800018310547 20.823999404907227,-50.45800018310547"></path></mask><mask id="__lottie_element_7092"><rect fill="#ffffff" width="96" height="96"></rect><path fill="#000000" clip-rule="nonzero" d=" M21.899999618530273,-45.80699920654297 C21.899999618530273,-45.80699920654297 -10.57800006866455,-36.2400016784668 -10.57800006866455,-36.2400016784668 C-10.57800006866455,-36.2400016784668 21.648000717163086,-8.79800033569336 21.648000717163086,-8.79800033569336 C21.648000717163086,-8.79800033569336 21.899999618530273,-45.80699920654297 21.899999618530273,-45.80699920654297"></path></mask><clippath id="__lottie_element_7094"><path fill="#ffffff" clip-rule="nonzero" d=" M21.899999618530273,-45.80699920654297 C