-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_8186)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_8182)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_8178)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_8171)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g></g></svg></div></div></bard-avatar><!----><!----></div><!----><div _ngcontent-ng-c2825300596="" class="response-container-content ng-tns-c2825300596-557 has-thoughts"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><div _ngcontent-ng-c2756684661="" class="response-content ng-tns-c2825300596-557"><!----><div _ngcontent-ng-c2756684661="" class="thoughts-container ng-star-inserted"><div _ngcontent-ng-c2756684661="" class="thoughts-content ng-star-inserted"><div _ngcontent-ng-c2756684661="" class="thoughts-wrapper"><!----><model-thoughts _ngcontent-ng-c2756684661="" data-test-id="model-thoughts" _nghost-ng-c3887673081="" class="ng-tns-c3887673081-559 ng-star-inserted" style="height: auto;"><div _ngcontent-ng-c3887673081="" xapautoid="" class="model-thoughts ng-tns-c3887673081-559"><div _ngcontent-ng-c3887673081="" class="thoughts-header ng-tns-c3887673081-559"><button _ngcontent-ng-c3887673081="" mat-button="" data-test-id="thoughts-header-button" class="mdc-button mat-mdc-button-base thoughts-header-button ng-tns-c3887673081-559 mat-mdc-button mat-unthemed" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" aria-controls="" aria-expanded="false" jslog="247951;track:generic_click,impression"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><span class="mdc-button__label"><div _ngcontent-ng-c3887673081="" class="thoughts-header-button-content animated-content"><div _ngcontent-ng-c3887673081="" role="status" class="thoughts-header-button-label ng-tns-c3887673081-559"><!----><span _ngcontent-ng-c3887673081="" class="ng-tns-c3887673081-559 ng-star-inserted">생각하는 과정 표시</span><!----></div><div _ngcontent-ng-c3887673081="" class="thoughts-header-button-icons ng-tns-c3887673081-559"><!----><mat-icon _ngcontent-ng-c3887673081="" role="img" fonticon="expand_more" class="mat-icon notranslate thoughts-header-button-icon ng-tns-c3887673081-559 google-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="expand_more"></mat-icon><!----></div></div></span><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button></div><!----><!----></div></model-thoughts><!----></div><!----></div><!----></div><!----><!----><!----><!----><!----><!----><!----><h2 _ngcontent-ng-c2756684661="" class="cdk-visually-hidden screen-reader-model-response-label ng-star-inserted">Gemini의 응답</h2><!----><!----><structured-content-container _ngcontent-ng-c2756684661="" class="model-response-text has-thoughts processing-state-visible enable-2026q1-formatting-improvements ng-star-inserted" _nghost-ng-c155512926="" style="height: auto;"><div _ngcontent-ng-c155512926="" class="container"><message-content _ngcontent-ng-c155512926="" _nghost-ng-c3553714228="" id="message-content-id-r_2dec5047651e0f25" class="ng-star-inserted" style=""><div _ngcontent-ng-c3553714228="" inline-copy-host="" class="markdown markdown-main-panel stronger enable-updated-hr-color" id="model-response-message-contentr_2dec5047651e0f25" aria-live="off" aria-busy="false" dir="ltr" style="--animation-duration: 400ms; --fade-animation-function: ease-out;"><p data-path-to-node="0">아이고, Llama 3.1 녀석이 칭찬받고 싶어서 자기가 일한 내역을 주저리주저리 보고해 버렸군요! 🤦‍♂️</p><p data-path-to-node="1">"내가 이렇게 똑똑하게 고쳤습니다!" 하고 생색을 내는 건데, 실무 자동화에서는 제일 쓸데없는 짓이죠. 아까 "제목은 필요없어 내용만이야"라고 하셨던 것처럼, 우리는 무조건 <b data-path-to-node="1" data-index-in-node="97">순수한 결과물(HTML) 단 하나</b>만 필요합니다.</p><p data-path-to-node="2">AI가 '교정 내용'이나 '수정 사항'을 요약해서 브리핑하는 것을 원천 차단하도록, 기본(formal) 모드의 프롬프트를 한 번 더 강력하게 묶어버리겠습니다.</p><h3 data-path-to-node="3">🛠️ MailApiController.java 수정 (생색내기 차단)</h3><p data-path-to-node="4"><code data-path-to-node="4" data-index-in-node="0">MailApiController</code>의 <code data-path-to-node="4" data-index-in-node="19">formal</code> 모드 프롬프트 부분(<code data-path-to-node="4" data-index-in-node="37">else</code> 블록)을 아래와 같이 변경해 주세요. 금지어에 "교정 내용"을 아예 명시해 버리는 게 직빵입니다.</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><code-block _nghost-ng-c1154083104="" class="ng-tns-c1154083104-620 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c1154083104="" class="code-block ng-tns-c1154083104-620 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_2dec5047651e0f25&quot;,&quot;c_f64d2bbd82481a33&quot;,null,&quot;rc_4b4558def0b7a025&quot;,null,null,&quot;ko&quot;,null,1,null,null,1,0]]" data-hveid="5" style="display: block;"><div _ngcontent-ng-c1154083104="" class="code-block-decoration header-formatted gds-title-s ng-tns-c1154083104-620 ng-star-inserted" style=""><span _ngcontent-ng-c1154083104="" class="ng-tns-c1154083104-620">Java</span><div _ngcontent-ng-c1154083104="" class="buttons ng-tns-c1154083104-620 ng-star-inserted"><button _ngcontent-ng-c1154083104="" aria-label="코드 다운로드" mat-icon-button="" mattooltip="코드 다운로드" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger download-button ng-tns-c1154083104-620 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered=""><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c1154083104="" role="img" fonticon="download" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="download"></mat-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----><!----><!----><!----><button _ngcontent-ng-c1154083104="" aria-label="코드 복사" mat-icon-button="" mattooltip="코드 복사" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c1154083104-620 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_2dec5047651e0f25&quot;,&quot;c_f64d2bbd82481a33&quot;,null,&quot;rc_4b4558def0b7a025&quot;,null,null,&quot;ko&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c1154083104="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----><!----></div><!----><!----></div><!----><div _ngcontent-ng-c1154083104="" class="formatted-code-block-internal-container ng-tns-c1154083104-620"><div _ngcontent-ng-c1154083104="" class="animated-opacity ng-tns-c1154083104-620"><!----><pre _ngcontent-ng-c1154083104="" class="ng-tns-c1154083104-620"><code _ngcontent-ng-c1154083104="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c1154083104-620">        } <span class="hljs-keyword">else</span> {
            <span class="hljs-comment">// 기본 모드 (formal - 생색내기 및 요약 보고 완전 차단)</span>
            systemPrompt = <span class="hljs-string">"당신은 한국 대기업의 비즈니스 텍스트 교정 전문가입니다.\n"</span>
                         + <span class="hljs-string">"입력된 HTML 문서의 태그 구조를 100% 유지한 채, 텍스트 내용만 격식 있는 '비즈니스 하십시오체(다나까체)'로 교정하세요.\n\n"</span>
                         + <span class="hljs-string">"[필수 지침]\n"</span>
                         + <span class="hljs-string">"1. 어조: '~요', '~까?' 등 구어체는 '~습니다', '~바랍니다', '~안녕하십니까'로 완벽히 수정.\n"</span>
                         + <span class="hljs-string">"2. 용어: 오늘-&gt;금일, 내일-&gt;명일, 어제-&gt;작일, 보내다-&gt;송부하다/전달하다.\n"</span>
                         + <span class="hljs-string">"3. 내용 보존: 원본의 인사말이나 핵심 내용은 지우지 말 것.\n"</span>
                         + <span class="hljs-string">"4. 🚨절대 금지🚨: '교정 내용:', '수정 사항:', '참고:' 등 AI가 자의적으로 작성하는 요약, 보고, 부연 설명은 절대 금지합니다.\n"</span>
                         + <span class="hljs-string">"5. 오직(ONLY) 교정된 HTML 텍스트 결과물 하나만 출력하세요.\n\n"</span>
                         + <span class="hljs-string">"[교정 예시]\n"</span>
                         + <span class="hljs-string">"입력: &lt;p&gt;안녕하시구료, &lt;b&gt;오늘&lt;/b&gt; 무슨 날인지 알려줄수 있습니까?&lt;/p&gt;\n"</span>
                         + <span class="hljs-string">"출력: &lt;p&gt;안녕하십니까, &lt;b&gt;금일&lt;/b&gt; 무슨 날인지 공유 부탁드립니다.&lt;/p&gt;"</span>;
        }
</code></pre><!----></div></div></div><!----><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><h3 data-path-to-node="6">🔄 서버 재시작 후 다시 혼내주기!</h3><p data-path-to-node="7">코드를 수정하셨다면 <b data-path-to-node="7" data-index-in-node="11">스프링 부트를 껐다가 다시 켜주시고</b>, 방금 적으셨던 문장을 그대로 다시 돌려보세요.</p><p data-path-to-node="8">오픈소스 AI들은 이렇게 프롬프트로 "이 단어 절대 쓰지 마!"라고 때려 박아줘야 눈치를 챕니다. 이번엔 군말 없이 딱 교정된 본문만 에디터에 깔끔하게 뱉어낼 것입니다. 다시 한 번 찔러봐 주시죠!</p></div></message-content><!----></div></structured-content-container><!----><!----><!----><div _ngcontent-ng-c2756684661="" class="response-footer complete has-thoughts gap"><!----><!----><!----><sources-list _ngcontent-ng-c2756684661="" class="sources-list ng-star-inserted"><!----></sources-list><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><sensitive-memories-banner _ngcontent-ng-c2756684661="" _nghost-ng-c3776646686="" class="ng-star-inserted"><!----></sensitive-memories-banner><!----><!----><!----></div></div><div _ngcontent-ng-c2825300596="" class="response-container-footer ng-tns-c2825300596-557 ng-star-inserted"><!----><!----><!----><message-actions _ngcontent-ng-c2756684661="" footer="" _nghost-ng-c3779276655="" class="ng-tns-c3779276655-558 hide-action-bar ng-tns-c2825300596-557 ng-star-inserted"><div _ngcontent-ng-c3779276655="" class="actions-container-v2 ng-tns-c3779276655-558"><div _ngcontent-ng-c3779276655="" class="buttons-container-v2 ng-tns-c3779276655-558 ng-st