_6755" spreadMethod="pad" gradientUnits="userSpaceOnUse"><stop></stop><stop></stop><stop></stop></lineargradient><lineargradient id="__lottie_element_6759" spreadMethod="pad" gradientUnits="userSpaceOnUse"><stop></stop><stop></stop><stop></stop><stop></stop><stop></stop></lineargradient><lineargradient id="__lottie_element_6763" spreadMethod="pad" gradientUnits="userSpaceOnUse" x1="-16" y1="0" x2="16" y2="0"><stop offset="0%" stop-color="rgb(49,134,255)"></stop><stop offset="50%" stop-color="rgb(49,134,255)"></stop><stop offset="100%" stop-color="rgb(49,134,255)"></stop><stop offset="100%" stop-color="rgb(49,134,255)"></stop><stop offset="100%" stop-color="rgb(49,134,255)"></stop></lineargradient></defs><g clip-path="url(#__lottie_element_6736)"><g transform="matrix(1,0,0,1,16,16)" opacity="1" style="display: block;"><g opacity="1" transform="matrix(1,0,0,1,0,0)"><path stroke="url(#__lottie_element_6763)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4" stroke-opacity="1" stroke-width="2" d=" M-4.383999824523926,-14.347999572753906 C-2.996999979019165,-14.772000312805176 -1.524999976158142,-15 0,-15 C0,-15 0,-15 0,-15 C1.7100000381469727,-15 3.3540000915527344,-14.713000297546387 4.886000156402588,-14.1850004196167"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_6759)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_6755)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_6751)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_6747)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_6740)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g></g></svg></div></div></bard-avatar><!----><!----></div><!----><div _ngcontent-ng-c2825300596="" class="response-container-content ng-tns-c2825300596-452"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><div _ngcontent-ng-c2756684661="" class="response-content ng-tns-c2825300596-452"><!----><div _ngcontent-ng-c2756684661="" class="thoughts-container ng-star-inserted"><!----></div><!----><!----><!----><!----><!----><!----><!----><h2 _ngcontent-ng-c2756684661="" class="cdk-visually-hidden screen-reader-model-response-label ng-star-inserted">Gemini의 응답</h2><!----><!----><structured-content-container _ngcontent-ng-c2756684661="" class="model-response-text processing-state-visible enable-2026q1-formatting-improvements ng-star-inserted" _nghost-ng-c155512926="" style="height: auto;"><div _ngcontent-ng-c155512926="" class="container"><message-content _ngcontent-ng-c155512926="" _nghost-ng-c3553714228="" id="message-content-id-r_d9f1181ade30c2ba" class="ng-star-inserted" style=""><div _ngcontent-ng-c3553714228="" inline-copy-host="" class="markdown markdown-main-panel stronger enable-updated-hr-color" id="model-response-message-contentr_d9f1181ade30c2ba" aria-live="off" aria-busy="false" dir="ltr" style="--animation-duration: 400ms; --fade-animation-function: ease-out;"><p data-path-to-node="0">아, <code data-path-to-node="0" data-index-in-node="3">null</code>이 나왔군요! 그럴 수 있습니다. 크롬 익스텐션에서 <code data-path-to-node="0" data-index-in-node="36">iframe</code>을 다룰 때 아주 흔하게 부딪히는 '로딩 타이밍'이나 '보안(CORS)' 문제일 가능성이 높습니다.</p><p data-path-to-node="1">화면(DOM) 구조를 보면 분명히 저 아이디(<code data-path-to-node="1" data-index-in-node="25">dext5_design_tbContentElement</code>)를 가진 <code data-path-to-node="1" data-index-in-node="60">iframe</code>이 존재하는데 익스텐션이 못 찾는다면, 다음 두 가지 원인 중 하나입니다.</p><hr data-path-to-node="2"><h3 data-path-to-node="3">🕵️‍♂️ 원인 1: 에디터가 아직 안 그려졌을 때 버튼을 눌렀다 (타이밍 문제)</h3><p data-path-to-node="4">그룹웨어 화면이 뜨자마자 익스텐션은 코드를 쫙 실행하는데, DEXT5 에디터처럼 무거운 상용 에디터는 화면이 다 켜지고 나서도 몇 초 뒤에 천천히 스크립트가 돌면서 <code data-path-to-node="4" data-index-in-node="92">iframe</code>을 생성합니다.
버튼을 클릭하는 순간에는 생성되어 있겠지만, 혹시나 해서 요소를 찾는 방식을 조금 더 안전하게 바꿔보겠습니다.</p><h3 data-path-to-node="5">🕵️‍♂️ 원인 2: 익스텐션이 iframe 내부를 쳐다보는 것을 차단당했다 (권한 문제 - 가장 유력)</h3><p data-path-to-node="6">가장 유력한 원인입니다. 크롬 익스텐션은 보안상 기본적으로 "자기가 주입된 현재 창(<code data-path-to-node="6" data-index-in-node="47">window</code>)"만 조작할 수 있습니다.
웹 에디터(<code data-path-to-node="6" data-index-in-node="75">iframe</code>)는 본체 화면 안에 있는 '또 다른 독립적인 창'이기 때문에, 익스텐션이 밖에서 함부로 <code data-path-to-node="6" data-index-in-node="131">iframe</code> 속으로 손을 뻗어 <code data-path-to-node="6" data-index-in-node="148">document.getElementById</code>를 하려고 하면 브라우저가 차단하고 <code data-path-to-node="6" data-index-in-node="191">null</code>을 뱉어버리는 경우가 많습니다.</p><h3 data-path-to-node="7">🛠️ 해결책: manifest.json 권한(all_frames) 추가하기</h3><p data-path-to-node="8">이 문제는 아주 간단한 설정 하나로 해결됩니다!
"이 익스텐션은 화면 안에 있는 iframe 에디터 안쪽까지 침투해도 된다"라고 허락을 받아야 합니다.</p><p data-path-to-node="9"><code data-path-to-node="9" data-index-in-node="0">extension</code> 폴더 안의 <b data-path-to-node="9" data-index-in-node="16"><code data-path-to-node="9" data-index-in-node="16">manifest.json</code></b> 파일을 열고, <code data-path-to-node="9" data-index-in-node="38">all_frames: true</code> 옵션을 한 줄 추가해 주세요.</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><code-block _nghost-ng-c1154083104="" class="ng-tns-c1154083104-566 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c1154083104="" class="code-block ng-tns-c1154083104-566 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_d9f1181ade30c2ba&quot;,&quot;c_f64d2bbd82481a33&quot;,null,&quot;rc_b7cff8b90aaee0f9&quot;,null,null,&quot;ko&quot;,null,1,null,null,1,1]]" data-hveid="4" style="display: block;"><div _ngcontent-ng-c1154083104="" class="code-block-decoration header-formatted gds-title-s ng-tns-c1154083104-566 ng-star-inserted" style=""><span _ngcontent-ng-c1154083104="" class="ng-tns-c1154083104-566">JSON</span><div _ngcontent-ng-c1154083104="" class="buttons ng-tns-c1154083104-566 ng-star-inserted"><button _ngcontent-ng-c1154083104="" aria-label="코드 다운로드" mat-icon-button="" mattooltip="코드 다운로드" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger download-button ng-tns-c1154083104-566 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered=""><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c1154083104="" role="img" fonticon="download" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="download"></mat-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----><!----><!----><!----><button _ngcontent-ng-c1154083104="" aria-label="코드 복사" mat-icon-button="" mattooltip="코드 복사" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c1154083104-566 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_d9f1181ade30c2ba&quot;,&quot;c_f64d2bbd82481a33&quot;,null,&quot;rc_b7cff8b90aaee0f9&quot;,null,null,&quot;ko&quot;,null,1,null,null,1,1]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c1154083104="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----><!----></div><!----><!----></div><!----><div _ngcontent-ng-c1154083104="" class="formatted-code-block-internal-container ng-tns-c1154083104-566"><div _ngcontent-ng-c1154083104="" class="animated-opacity ng-tns-c1154083104-566"><!----><pre _ngcontent-ng-c1154083104="" class="ng-tns-c1154083104-566"><code _ngcontent-ng-c1154083104="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c1154083104-566">{
  <span class="hljs-attr">"manifest_version"</span>: <span class="hljs-number">3</span>,
  <span class="hljs-attr">"name"</span>: <span class="hljs-string">"AI 메일 어시스턴트 (KG ICT)"</span>,
  <span class="hljs-attr">"version"</span>: <span class="hljs-string">"1.0"</span>,
  <span class="hljs-attr">"description"</span>: <span class="hljs-string">"사내 그룹웨어 웹 메일 작성 팝업에서만 AI 교정 기능을 제공합니다."</span>,
  <span class="hljs-attr">"content_scripts"</span>: [
    {
      <span class="hljs-attr">"matches"</span>: [
        <span class="hljs-string">"https://gw.kggroup.co.kr/mail/userMail/goMailWindowWritePopup.do*"</span>
      ],
      <span class="hljs-attr">"js"</span>: [<span class="hljs-string">"content.js"</span>],
      <span class="hljs-attr">"all_frames"</span>: <span class="hljs-literal">true</span> <span class="hljs-comment">// ✨ 이 줄을 추가하세요! (iframe 내부까지 진입 허용)</span>
    }
  ]
}
</code></pre><!----></div></div></div><!----><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><h3 data-path-to-node="11">🛠️ (선택) content.js 조금 더 안전하게 다듬기</h3><p data-path-to-node="12"><code data-path-to-node="12" data-index-in-node="0">all_frames</code>를 켜면, 우리 익스텐션(<code data-path-to-node="12" data-index-in-node="24">content.js</code>)이 본체 화면에도 한 번 실행되고, <code data-path-to-node="12" data-index-in-node="55">iframe</code> 안쪽 화면에도 또 한 번 실행됩니다!</p><p data-path-to-node="13">그래서 <code data-path-to-node="13" data-index-in-node="4">content.js</code> 내부에서 "내가 지금 본체에 있는 건가? 아니면 에디터 iframe 속에 들어온 건가?"를 스스로 판단해서 텍스트를 뽑도록 코드를 아주 스마트하게 바꿀 수 있습니다.</p><p data-path-to-node="14"><b data-path-to-node="14" data-index-in-node="0"><code data-path-to-node="14" data-index-in-node="0">content.js</code>의 클릭 이벤트 부분을 아래처럼 바꿔보세요.</b></p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><code-block _nghost-ng-c1154083104="" class="ng-tns-c1154083104-567 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c1154083104="" class="code-block ng-tns-c1154083104-567 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_d9f1181ade30c2ba&quot;,&quot;c_f64d2bbd82481a33&quot;,null,&quot;rc_b7cff8b90aaee0f9&quot;,null,null,&quot;ko&quot;,null,1,null,null,1,1]]" data-hveid="6" style="display: block;"><div _ngcontent-ng-c1154083104="" class="code-block-decoration header-formatted gds-title-s ng-tns-c1154083104-567 ng-star-inserted" style=""><span _ngcontent-ng-c1154083104="" class="ng-tns-c1154083104-567">JavaScript</span><div _ngcontent-ng-c1154083104="" class="buttons ng-tns-c1154083104-567 ng-star-inserted"><button _ngcontent-ng-c1154083104="" aria-label="코드 다운로드" mat-icon-button="" mattooltip="코드 다운로드" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger download-button ng-tns-c1154083104-567 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered=""><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c1154083104="" role="img" fonticon="download" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="download"></mat-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----><!----><!----><!----><button _ngcontent-ng-c1154083104="" aria-label="코드 복사" mat-icon-button="" mattooltip="코드 복사" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c1154083104-567 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_d9f1181ade30c2ba&quot;,&quot;c_f64d2bbd82481a33&quot;,null,&quot;rc_b7cff8b90aaee0f9&quot;,null,null,&quot;ko&quot;,null,1,null,null,1,1]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c1154083104="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----><!----></div><!----><!----></div><!----><div _ngcontent-ng-c1154083104="" class="formatted-code-block-internal-container ng-tns-c1154083104-567"><div _ngcontent-ng-c1154083104="" class="animated-opacity ng-tns-c1154083104-567"><!----><pre _ngcontent-ng-c1154083104="" class="ng-tns-c1154083104-567"><code _ngcontent-ng-c1154083104="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c1154083104-567">aiButton.addEventListener(<span class="hljs-string">"click"</span>, <span class="hljs-function">() =&gt;</span> {
    
    <span class="hljs-comment">// 1. DEXT5 에디터가 만들어주는 '숨겨진 텍스트 상자'를 먼저 찾습니다.</span>
    <span class="hljs-comment">// 고급 웹 에디터들은 보통 iframe 내용을 폼 전송용 hidden input(또는 textarea)에 동기화해둡니다.</span>
    <span class="hljs-keyword">const</span> hiddenSource = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"dext5_source_tbContentElement"</span>);
    <span class="hljs-keyword">const</span> hiddenText = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"dext5_text_tbContentElement"</span>);

    <span class="hljs-comment">// 만약 숨겨진 텍스트 상자에서 바로 값을 뺄 수 있다면 굳이 iframe을 안 파고들어도 됩니다.</span>
    <span class="hljs-keyword">if</span> (hiddenText &amp;&amp; hiddenText.value) {
        alert(<span class="hljs-string">"숨겨진 텍스트에서 성공!: \n"</span> + hiddenText.value);
        <span class="hljs-keyword">return</span>;
    }

    <span class="hljs-comment">// 2. 만약 위 방법이 안 먹힌다면, 직접 iframe을 찾습니다.</span>
    <span class="hljs-keyword">const</span> editorIframe = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"dext5_design_tbContentElement"</span>);

    <span class="hljs-keyword">if</span> (editorIframe) {
        <span class="hljs-keyword">try</span> {
            <span class="hljs-keyword">const</span> iframeDocument = editorIframe.contentDocument || editorIframe.contentWindow.document;
            <span class="hljs-keyword">const</span> letterDiv = iframeDocument.querySelector(<span class="hljs-string">'div[name="letter"]'</span>);
            
            <span class="hljs-keyword">if</span> (letterDiv) {
                alert(<span class="hljs-string">"iframe 침투 성공!\n\n"</span> + letterDiv.innerText);
            } <span class="hljs-keyword">else</span> {
                alert(<span class="hljs-string">"letter 영역을 찾을 수 없습니다."</span>);
            }
        } <span class="hljs-keyword">catch</span> (error) {
            alert(<span class="hljs-string">"보안 정책으로 iframe 접근이 차단되었습니다. 개발자 도구 콘솔을 확인하세요."</span>);
            <span class="hljs-built_in">console</span>.error(error);
        }
    } <span class="hljs-keyword">else</span> {
        <span class="hljs-comment">// 3. 만약 익스텐션이 이미 iframe '내부'에서 실행 중이라면 여기서 바로 찾을 수 있습니다!</span>
        <span class="hljs-keyword">const</span> letterDivInside = <span class="hljs-built_in">document</span>.querySelector(<span class="hljs-string">'div[name="letter"]'</span>);
        <span class="hljs-keyword">if</span> (letterDivInside) {
             alert(<span class="hljs-string">"에디터 내부 침투 성공!\n\n"</span> + letterDivInside.innerText);
        } <span class="hljs-keyword">else</span> {
             alert(<span class="hljs-string">"에디터 화면을 찾을 수 없습니다."</span>);
        }
    }
});
</code></pre><!----></div></div></div><!----><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="16"><code data-path-to-node="16" data-index-in-node="0">manifest.json</code> 수정(<code data-path-to-node="16" data-index-in-node="17">all_frames</code>)과 <code data-path-to-node="16" data-index-in-node="30">content.js</code> 수정 후, 다시 크롬에서 새로고침하시고 테스트를 한 번 해봐 주시겠어요?
